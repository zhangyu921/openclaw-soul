{
  "name": "openclaw-soul",
  "private": true,
  "workspaces": [
    "web",
    "packages/cli"
  ],
  "bin": {
    "ocs": "./packages/cli/dist/index.js"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w @openclaw-soul/cli && npm run build -w web",
    "db:push": "npm run db:push -w web",
    "db:studio": "npm run db:studio -w web",
    "ocs": "npm run ocs -w @openclaw-soul/cli --"
  }
}
