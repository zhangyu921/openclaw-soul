generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  handle       String?       @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  packs        Pack[]
  apiTokens    ApiToken[]
  deviceLogins DeviceLogin[]
}

model ApiToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  label     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Pack {
  id                   String    @id @default(cuid())
  slug                 String
  title                String
  summary              String?
  zipRelPath           String
  avatarRelPath        String?
  /// SOUL.md excerpt from zip at publish (UTF-8); capped in extractPackPreviewFromZip.
  soulPreviewMd        String?   @db.Text
  /// True when SOUL body was cut at the byte cap (full file in zip).
  soulPreviewTruncated Boolean   @default(false)
  /// Sorted relative paths of file entries (max count capped); full contents via zip download.
  packFilePaths        Json      @default("[]")
  authorId             String
  author               User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  /// Soft-unpublish: hidden from gallery & download; row and files kept.
  revokedAt            DateTime?

  @@unique([authorId, slug])
}

/// OAuth-style device flow: CLI polls with device_code; user approves in browser with user_code.
model DeviceLogin {
  id               String   @id @default(cuid())
  deviceCodeHash   String   @unique
  userCode         String   @unique
  status           String
  expiresAt        DateTime
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accessTokenPlain String?
  createdAt        DateTime @default(now())
}
