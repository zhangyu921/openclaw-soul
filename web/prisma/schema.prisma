generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  handle       String?       @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  packs        Pack[]
  apiTokens    ApiToken[]
  deviceLogins DeviceLogin[]
}

model ApiToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  label     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Pack {
  id            String   @id @default(cuid())
  slug          String
  title         String
  summary       String?
  zipRelPath    String
  avatarRelPath String?
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([authorId, slug])
}

/// OAuth-style device flow: CLI polls with device_code; user approves in browser with user_code.
model DeviceLogin {
  id               String   @id @default(cuid())
  deviceCodeHash   String   @unique
  userCode         String   @unique
  status           String
  expiresAt        DateTime
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accessTokenPlain String?
  createdAt        DateTime @default(now())
}
