generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PackVisibility {
  UNLISTED
  LISTED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  handle       String?       @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  packs        Pack[]
  apiTokens    ApiToken[]
  deviceLogins DeviceLogin[]
}

model ApiToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  label     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Pack {
  id                   String    @id @default(cuid())
  slug                 String
  title                String
  summary              String?
  /// Cached zip bytes in blob/local storage; null after source edits until next download/apply rebuild.
  zipRelPath           String?
  avatarRelPath        String?
  /// Sorted relative paths of file entries (max count capped); derived from md/binary rows; full contents via zip download.
  packFilePaths        Json      @default("[]")
  /// 详情页展示：Markdown 正文（与 zip 解耦，可重复编辑）。
  showcaseMd           String?   @db.Text
  /// 对话截图等展示图，顺序即展示顺序；每项为 storage 引用（本地相对路径或 Blob URL），最多 10 条。
  showcaseImageRefs    Json      @default("[]")
  authorId             String
  author               User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Set when the author removes this Soul from「我的 Souls」: row kept, slug rewritten to release handle/slug for a new pack.
  authorDashboardHiddenAt DateTime?
  slugBeforeDashboardHide String?
  /// 站内涵览：详情页被非作者打开次数（首页画廊 card 可展示，>10）。
  profileViewCount     Int            @default(0)
  createdAt            DateTime       @default(now())
  visibility           PackVisibility @default(UNLISTED)
  markdownFiles        PackMarkdownFile[]
  binaryFiles          PackBinaryFile[]

  @@unique([authorId, slug])
}

/// Markdown files: pack source-of-truth (zip-relative `path`).
model PackMarkdownFile {
  id        String   @id @default(cuid())
  packId    String
  pack      Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  path      String
  content   String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([packId, path])
}

/// Non-markdown blobs: `storageRef` is Blob URL or path consistent with `zipRelPath` style.
model PackBinaryFile {
  id          String  @id @default(cuid())
  packId      String
  pack        Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  path        String
  storageRef  String
  byteSize    Int?
  sha256      String?

  @@unique([packId, path])
}

/// OAuth-style device flow: CLI polls with device_code; user approves in browser with user_code.
model DeviceLogin {
  id               String   @id @default(cuid())
  deviceCodeHash   String   @unique
  userCode         String   @unique
  status           String
  expiresAt        DateTime
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  accessTokenPlain String?
  createdAt        DateTime @default(now())
}

model EmailLoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt(sort: Desc)])
  @@index([expiresAt])
}
