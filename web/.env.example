# PostgreSQL（本地可用仓库根目录 `docker compose up -d`，默认库见 docker-compose.yml）
DATABASE_URL="postgresql://openclaw:openclaw@localhost:55432/openclaw_soul"

AUTH_SECRET="change-me-at-least-16-characters-long"

# 可选：对外主域（无尾斜杠）。多域/换域时让 device 授权链接等始终指向 canonical URL
# OPENCLAW_SOUL_SITE_URL=https://openclaw-soul.example.com

# 上传文件：默认 web/storage；生产建议 Vercel Blob（设 token 或 STORAGE_DRIVER）
# STORAGE_PATH=
# STORAGE_DRIVER=vercel-blob
# BLOB_READ_WRITE_TOKEN=
# Vercel 控制台里 Blob 存储为「私有」时必须（与 put public 冲突会 500）：
# BLOB_ACCESS=private
