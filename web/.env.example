
DATABASE_URL="postgresql://openclaw:openclaw@localhost:55432/openclaw_soul"
AUTH_SECRET="change-me-at-least-16-characters-long"
# GitHub OAuth（可选：用于 Web 一键登录）
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# 可选：对外主域（无尾斜杠）。多域/换域时让 device 授权链接等始终指向 canonical URL
# OPENCLAW_SOUL_SITE_URL=https://openclaw-soul.basilfield.com

# 上传文件：本地dev使用目录（无需配置）：web/storage ；生产使用 Vercel Blob
# STORAGE_DRIVER="vercel-blob"
# BLOB_ACCESS="private"
# BLOB_READ_WRITE_TOKEN=""

# Pack 详情页即时 chat（Ollama 或 MiniMax；均未配置则 chat 返回 503）
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2:7b-instruct
# MiniMax Token Plan（控制台「Token Plan Key」；Anthropic 兼容 API）
# MINIMAX_TOKEN_PLAN_API_KEY=
# MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic/v1
# MINIMAX_CHAT_MODEL=MiniMax-M2.7
