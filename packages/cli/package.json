  "version": "0.0.5",
  "description": "CLI for OpenClaw Soul — share and apply OpenClaw workspace packs (ocs)",
  "type": "module",
  "bin": {
    "ocs": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyu921/openclaw-soul.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/zhangyu921/openclaw-soul#readme",
